generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  password            String
  role                Role      @default(USER)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  phoneNumber         String?
  address             String?
  profileImg          String?
  membershipActive    Boolean   @default(false)
  membershipExpiresAt DateTime?
  membershipType      String?

  books        Book[]
  transactions Transaction[]
  reviews      Review[]
}

model Book {
  id         String   @id @default(uuid())
  title      String
  author     String
  price      Int
  condition  String
  category   String
  story      String
  accessible Boolean  @default(false)
  img        String?
  ownerId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id])
  reviews      Review[]
  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  type      String
  amount    Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])
}

enum Role {
  ADMIN
  USER
}
